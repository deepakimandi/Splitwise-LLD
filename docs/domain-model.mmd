classDiagram
    direction LR
    class User {
        -String userId
        -String name
        -String email
    }
    class Group {
        <<Aggregate Root>>
        -String groupId
        -String name
        -Map~String,User~ members
        -BalanceSheet ledger
        +addMember(User)
        +removeMember(User)
        +recordExpense(Expense)
        +revertExpense(Expense)
        +recordPayment(Payment)
        +netBalances() Map~User,BigDecimal~
    }
    class Expense {
        <<immutable, built by Builder>>
        -String expenseId
        -String groupId
        -String description
        -User paidBy
        -BigDecimal amount
        -SplitType splitType
        -List~Split~ splits
        +involvedUserIds() Set~String~
    }
    class Split {
        <<record>>
        User user
        BigDecimal amount
    }
    class SplitType {
        <<enum>>
        EQUAL
        EXACT
        PERCENTAGE
        SHARES
    }
    class Payment {
        <<record: real settle-up>>
        User from
        User to
        BigDecimal amount
    }
    class Transaction {
        <<record: suggested transfer>>
        User from
        User to
        BigDecimal amount
    }
    class BalanceSheet {
        <<one per group>>
        -balances : userId → userId → BigDecimal
        -LockManager lockManager
        +applyExpense(Expense, precondition)
        +revertExpense(Expense)
        +applyPayment(Payment, precondition)
        +getBalance(userId, other) BigDecimal
        +netBalances(userIds) Map
        +snapshot(userIds) Map
    }
    class LockManager {
        -ConcurrentHashMap~String,ReentrantLock~ locks
        +withLocks(keys, action) T
    }
    Group "1" *-- "1" BalanceSheet : owns
    Group "1" o-- "2..*" User : members
    BalanceSheet "1" *-- "1" LockManager
    Group "1" ..> "*" Expense : records
    Group "1" ..> "*" Payment : records
    Expense "1" *-- "1..*" Split
    Expense --> SplitType
    Expense --> User : paidBy
    Split --> User
